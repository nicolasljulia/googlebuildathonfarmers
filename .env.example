# Earth Engine — reusing the openfarm-analytics GCP project.
# Locally you can skip EE_SERVICE_ACCOUNT_JSON entirely and run
# `earthengine authenticate` once instead (uses your own Google login).
EE_PROJECT_ID=openfarm-analytics

# Paste the full contents of a service account JSON key here as one line
# (Cloud Console -> IAM & Admin -> Service Accounts -> Keys -> Add Key -> JSON).
# The service account must be registered for Earth Engine access:
# https://signup.earthengine.google.com/#!/service_accounts
# Required for any deployed environment; never commit the real value.
EE_SERVICE_ACCOUNT_JSON=

# Optional overrides — defaults resolve relative to ./data
# OPENFARM_DATA_DIR=./data
# DISEASE_LIBRARY_PATH=./data/disease_library.csv
# MAXENT_TIF_DIR=./data/maxent_tifs
# MAXENT_DB_PATH=./data/maxent_suitability.db
# KOPPEN_DIR=./data/koppen
